
erDiagram
    source ||--o{ event : provides
    source ||--o{ ingestion_state : tracks
    ingestion_run ||--o{ rejected_record : quarantines
    event ||--o{ event_group : grouped_in
    event ||--o| landslide : details
    event ||--o| rainfall_observation : details
    event ||--o| lhasa_nowcast : details
    analysis_cell ||--o{ lhasa_nowcast : aggregates
    source {
        text source_id PK
        text name
        text url
        text format
        text license
    }
    ingestion_run {
        bigint run_id PK
        text mode
        timestamptz started
        timestamptz finished
        text status
        int rows_in
        int rows_new
        int rows_rejected
    }
    ingestion_state {
        text source_id PK
        text partition_key PK
        text watermark
        timestamptz last_success
    }
    event {
        text event_id PK
        text source FK
        text event_type
        timestamptz timestamp
        double latitude
        double longitude
        double severity
        text severity_unit
        text raw_reference
        text content_hash
    }
    event_group {
        bigint group_id PK
        text event_id PK
        text match_rule
    }
    rejected_record {
        bigint id PK
        bigint run_id FK
        text source
        text reason
        jsonb payload
    }
    landslide {
        text event_id PK
        int glc_event_id
        double location_accuracy_km
        boolean time_known
        text landslide_trigger
        text landslide_size
        int fatality_count
    }
    rainfall_observation {
        text event_id PK
        text period
        double precipitation_mm
        double soil_moisture_m3m3
        boolean is_forecast
    }
    lhasa_nowcast {
        text event_id PK
        timestamptz issue_time
        text cell_id FK
        double hazard_max
        double hazard_mean
        text etag
    }
    analysis_cell {
        text cell_id PK
        double centre_lat
        double centre_lon
        text department
    }
